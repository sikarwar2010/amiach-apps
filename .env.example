# Clerk — https://dashboard.clerk.com  (create an application, enable Email + Google if desired)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Routes (already wired in the app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/register

# Leave both keys empty to run in demo-auth mode (localStorage session, no real accounts).
# To make someone a Company Admin: Clerk Dashboard → Users → (user) → Public metadata:
#   { "role": "admin", "onboarded": true }
